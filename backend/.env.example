# ─── Local environment ────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ─── PostgreSQL (local / traditional backend DB — NOT Supabase) ──────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the Vite frontend dev server
FRONTEND_URL=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Name of the HTTP-only session cookie set by the auth endpoints
COOKIE_NAME=interora_session
