datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── ENUMS ───────────────────────────────────────────────────────────────────

enum AppRole {
  student
  faculty
  company
  mentor
  admin
  hod
}

enum AccountStatus {
  pending
  active
  inactive
  suspended
}

enum CompanyStatus {
  pending
  approved
  rejected
}

enum WorkMode {
  on_site
  remote
  hybrid
}

enum InternshipType {
  full_time
  part_time
}

enum PostingStatus {
  draft
  open
  closed
  archived
}

enum ApplicationStatus {
  submitted
  faculty_review
  faculty_approved
  faculty_rejected
  shortlisted
  selected
  rejected
  withdrawn
}

enum AssignmentStatus {
  upcoming
  active
  completed
  terminated
  suspended
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
  leave
}

enum PriorityLevel {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  assigned
  in_progress
  submitted
  reviewed
  closed
}

enum SubmissionReviewStatus {
  pending
  verified
  correction_required
  rejected
}

enum MilestoneStatus {
  pending
  in_progress
  delayed
  completed
}

enum ReportStatus {
  draft
  submitted
  reviewed
}

enum EvaluationType {
  mid_term
  final
}

enum EvaluationStatus {
  draft
  submitted
  pending_verification
  verified
  correction_required
}

enum RiskLevel {
  on_track
  needs_attention
  high_risk
}

enum PPOStatus {
  draft
  offered
  under_consideration
  not_converted
}

enum AdminApprovalStatus {
  pending
  approved
  rejected
}

enum StudentResponseStatus {
  pending
  accepted
  declined
}

enum CertificateStatus {
  active
  revoked
  reissued
}

enum NotificationCategory {
  applications
  interns
  tasks
  milestones
  evaluations
  ppo
  certificates
  risk
  system
}

// ── MODULE 1: IDENTITY & PROFILES ───────────────────────────────────────────

model Profile {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique @db.VarChar(255)
  passwordHash  String?       @map("password_hash") @db.VarChar(255)
  fullName      String        @map("full_name") @db.VarChar(150)
  role          AppRole       @default(student)
  accountStatus AccountStatus @default(active) @map("account_status")
  phone         String?       @db.VarChar(30)
  avatarUrl     String?       @map("avatar_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  // Role Sub-Profiles (1:1)
  studentProfile        StudentProfile?
  companyProfile        CompanyProfile?
  facultyProfile        FacultyProfile?
  industryMentorProfile IndustryMentorProfile?

  // System Relations
  assignedTasksCreated    Task[]            @relation("TaskCreator")
  evaluationsCreated      Evaluation[]      @relation("EvaluationCreator")
  headOfDepartments       Department[]      @relation("HOD")
  chatParticipants        ChatParticipant[]
  sentMessages            ChatMessage[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  systemSettingsUpdated   SystemSetting[]
  allocatorRuns           AllocatorRun[]
  ppoApprovals            PPOOffer[]        @relation("PPOAdminApprover")
  milestonesVerified      Milestone[]       @relation("MilestoneVerifier")
  taskSubmissionsReviewed TaskSubmission[]  @relation("SubmissionReviewer")
  weeklyReportsReviewed   WeeklyReport[]    @relation("ReportReviewer")

  @@index([role], name: "idx_profiles_role")
  @@map("profiles")
}

model Department {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String           @unique @db.VarChar(20)
  name               String           @db.VarChar(150)
  program            String           @default("B.Tech") @db.VarChar(50)
  headOfDepartmentId String?          @map("head_of_department_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  headOfDepartment Profile?         @relation("HOD", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)
  students         StudentProfile[]
  facultyMembers   FacultyProfile[]

  @@map("departments")
}

model StudentProfile {
  id              String   @id @db.Uuid
  studentId       String   @unique @map("student_id") @db.VarChar(50)
  departmentId    String   @map("department_id") @db.Uuid
  course          String   @default("B.Tech Computer Science") @db.VarChar(100)
  batchYear       String   @default("2026") @map("batch_year") @db.VarChar(10)
  batchDivision   String   @default("CS1") @map("batch_division") @db.VarChar(10)
  currentSemester String   @default("6th Semester") @map("current_semester") @db.VarChar(20)
  cgpa            Decimal? @db.Decimal(3, 2)
  skills          String[] @default([])
  resumeUrl       String?  @map("resume_url")
  resumeAnalysis  Json?    @map("resume_analysis")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  profile    Profile    @relation(fields: [id], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  applications       StudentApplication[]
  assignments        InternshipAssignment[]
  facultyMappings    FacultyStudentAssignment[]
  guidanceNotes      FacultyGuidanceNote[]
  learningProgress   StudentLearningProgress[]
  readinessSnapshots PlacementReadinessSnapshot[]
  ppoOffers          PPOOffer[]
  certificates       Certificate[]
  taskSubmissions    TaskSubmission[]

  @@index([departmentId], name: "idx_student_profiles_dept")
  @@map("student_profiles")
}

model CompanyProfile {
  id              String        @id @db.Uuid
  companyName     String        @map("company_name") @db.VarChar(200)
  industryDomain  String        @default("Software & Cloud Services") @map("industry_domain") @db.VarChar(100)
  contactPerson   String        @map("contact_person") @db.VarChar(150)
  officialEmail   String        @unique @map("official_email") @db.VarChar(255)
  phone           String        @db.VarChar(30)
  website         String?       @db.VarChar(255)
  companyAddress  String?       @map("company_address")
  geoLat          Float?        @map("geo_lat")
  geoLng          Float?        @map("geo_lng")
  geoFenceRadiusM Int           @default(500) @map("geo_fence_radius_m")
  approvalStatus  CompanyStatus @default(pending) @map("approval_status")
  verified        Boolean       @default(false)
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  profile      Profile                 @relation(fields: [id], references: [id], onDelete: Cascade)
  mentors      IndustryMentorProfile[]
  postings     InternshipPosting[]
  assignments  InternshipAssignment[]
  ppoOffers    PPOOffer[]
  certificates Certificate[]

  @@index([approvalStatus], name: "idx_company_profiles_approval")
  @@map("company_profiles")
}

model FacultyProfile {
  id            String   @id @db.Uuid
  facultyId     String   @unique @map("faculty_id") @db.VarChar(50)
  departmentId  String   @map("department_id") @db.Uuid
  designation   String   @default("Assistant Professor") @db.VarChar(100)
  cabinLocation String?  @map("cabin_location") @db.VarChar(100)
  officePhone   String?  @map("office_phone") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  profile    Profile    @relation(fields: [id], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  studentSupervisions  FacultyStudentAssignment[]
  guidanceNotes        FacultyGuidanceNote[]
  assignedInternships  InternshipAssignment[]
  crossVerifications   Evaluation[]               @relation("FacultyCrossVerifier")
  attendanceOverrides  AttendanceRecord[]         @relation("AttendanceOverrider")
  applicationsReviewed StudentApplication[]

  @@index([departmentId], name: "idx_faculty_profiles_dept")
  @@map("faculty_profiles")
}

model IndustryMentorProfile {
  id                  String   @id @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  designation         String   @db.VarChar(100)
  corporateDepartment String?  @map("corporate_department") @db.VarChar(100)
  expertiseAreas      String[] @default([]) @map("expertise_areas")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  profile             Profile                @relation(fields: [id], references: [id], onDelete: Cascade)
  company             CompanyProfile         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedInternships InternshipAssignment[]

  @@index([companyId], name: "idx_industry_mentors_company")
  @@map("industry_mentor_profiles")
}

// ── MODULE 2: ACADEMIC SUPERVISION ──────────────────────────────────────────

model FacultyStudentAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId  String   @map("faculty_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  status     String   @default("Active") @db.VarChar(30)

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([facultyId, studentId])
  @@index([facultyId, studentId], name: "idx_fac_stu_assign")
  @@map("faculty_student_assignments")
}

model FacultyGuidanceNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  category  String   @default("General") @db.VarChar(50)
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], name: "idx_guidance_student")
  @@map("faculty_guidance_notes")
}

// ── MODULE 3: MARKETPLACE & APPLICATIONS ────────────────────────────────────

model InternshipPosting {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  title               String         @db.VarChar(200)
  description         String
  industryDomain      String         @map("industry_domain") @db.VarChar(100)
  location            String         @default("Remote / On-site") @db.VarChar(150)
  workMode            WorkMode       @default(hybrid) @map("work_mode")
  internshipType      InternshipType @default(full_time) @map("internship_type")
  duration            String         @default("3 Months") @db.VarChar(50)
  stipend             String         @default("Unpaid / Paid") @db.VarChar(100)
  eligibility         String         @default("All Eligible") @db.VarChar(255)
  vacancies           Int            @default(1)
  skills              String[]       @default([])
  applicationDeadline DateTime?      @map("application_deadline")
  status              PostingStatus  @default(open)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  taskTemplates      InternshipTaskTemplate[]
  milestoneTemplates InternshipMilestoneTemplate[]
  applications       StudentApplication[]
  assignments        InternshipAssignment[]
  allocatorRuns      AllocatorRun[]

  @@index([companyId], name: "idx_postings_company")
  @@index([status], name: "idx_postings_status")
  @@map("internship_postings")
}

model InternshipTaskTemplate {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId String        @map("internship_id") @db.Uuid
  title        String        @db.VarChar(200)
  description  String?
  priority     PriorityLevel @default(medium)
  expectedDays Int?          @map("expected_days")
  createdAt    DateTime      @default(now()) @map("created_at")

  internship   InternshipPosting @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  spawnedTasks Task[]

  @@map("internship_task_templates")
}

model InternshipMilestoneTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId  String   @map("internship_id") @db.Uuid
  title         String   @db.VarChar(200)
  description   String?
  sequenceOrder Int      @default(1) @map("sequence_order")
  createdAt     DateTime @default(now()) @map("created_at")

  internship        InternshipPosting @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  spawnedMilestones Milestone[]

  @@map("internship_milestone_templates")
}

model StudentApplication {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId            String            @map("internship_id") @db.Uuid
  studentId               String            @map("student_id") @db.Uuid
  coverLetter             String?           @map("cover_letter")
  resumeUrl               String?           @map("resume_url")
  status                  ApplicationStatus @default(submitted)
  facultyRating           Decimal?          @map("faculty_rating") @db.Decimal(3, 1)
  facultyFeedback         String?           @map("faculty_feedback")
  facultyReviewedAt       DateTime?         @map("faculty_reviewed_at")
  facultyReviewedById     String?           @map("faculty_reviewed_by_id") @db.Uuid
  allocatorMatchScore     Decimal?          @map("allocator_match_score") @db.Decimal(5, 2)
  allocatorScoreBreakdown Json?             @map("allocator_score_breakdown")
  companyRemarks          String?           @map("company_remarks")
  appliedAt               DateTime          @default(now()) @map("applied_at")
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at")

  internship      InternshipPosting @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyReviewer FacultyProfile?   @relation(fields: [facultyReviewedById], references: [id], onDelete: SetNull)

  assignment InternshipAssignment?

  @@unique([internshipId, studentId])
  @@index([internshipId], name: "idx_apps_internship")
  @@index([studentId], name: "idx_apps_student")
  @@index([status], name: "idx_apps_status")
  @@map("student_applications")
}

model AllocatorRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internshipId   String   @map("internship_id") @db.Uuid
  runById        String   @map("run_by_id") @db.Uuid
  candidateCount Int      @map("candidate_count")
  weightsUsed    Json     @map("weights_used")
  resultsSummary Json     @map("results_summary")
  createdAt      DateTime @default(now()) @map("created_at")

  internship InternshipPosting @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  initiator  Profile           @relation(fields: [runById], references: [id], onDelete: Cascade)

  @@map("allocator_runs")
}

// ── MODULE 4: ACTIVE INTERNSHIP OPERATIONS ──────────────────────────────────

model InternshipAssignment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId        String           @unique @map("application_id") @db.Uuid
  studentId            String           @map("student_id") @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  internshipId         String           @map("internship_id") @db.Uuid
  facultyMentorId      String           @map("faculty_mentor_id") @db.Uuid
  industryMentorId     String           @map("industry_mentor_id") @db.Uuid
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime         @map("end_date") @db.Date
  actualCompletionDate DateTime?        @map("actual_completion_date") @db.Date
  status               AssignmentStatus @default(upcoming)
  terminationReason    String?          @map("termination_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  application    StudentApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student        StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company        CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  internship     InternshipPosting     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  facultyMentor  FacultyProfile        @relation(fields: [facultyMentorId], references: [id], onDelete: Restrict)
  industryMentor IndustryMentorProfile @relation(fields: [industryMentorId], references: [id], onDelete: Restrict)

  attendanceRecords AttendanceRecord[]
  tasks             Task[]
  milestones        Milestone[]
  workLogs          WorkLog[]
  weeklyReports     WeeklyReport[]
  evaluations       Evaluation[]
  healthSnapshots   HealthScoreSnapshot[]
  riskFlags         RiskFlag[]
  ppoOffer          PPOOffer?
  certificate       Certificate?

  @@index([studentId], name: "idx_assign_student")
  @@index([companyId], name: "idx_assign_company")
  @@index([facultyMentorId], name: "idx_assign_faculty")
  @@index([industryMentorId], name: "idx_assign_industry")
  @@index([status], name: "idx_assign_status")
  @@map("internship_assignments")
}

model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId     String           @map("assignment_id") @db.Uuid
  attendanceDate   DateTime         @default(now()) @map("attendance_date") @db.Date
  status           AttendanceStatus @default(present)
  checkInTime      DateTime?        @map("check_in_time")
  checkInPhotoUrl  String?          @map("check_in_photo_url")
  checkInLat       Float?           @map("check_in_lat")
  checkInLng       Float?           @map("check_in_lng")
  checkInAddress   String?          @map("check_in_address")
  checkOutTime     DateTime?        @map("check_out_time")
  checkOutPhotoUrl String?          @map("check_out_photo_url")
  checkOutLat      Float?           @map("check_out_lat")
  checkOutLng      Float?           @map("check_out_lng")
  checkOutAddress  String?          @map("check_out_address")
  workingHours     Decimal?         @default(0.00) @map("working_hours") @db.Decimal(4, 2)
  geoVerified      Boolean          @default(false) @map("geo_verified")
  facultyOverride  Boolean          @default(false) @map("faculty_override")
  overrideById     String?          @map("override_by_id") @db.Uuid
  overrideReason   String?          @map("override_reason")
  createdAt        DateTime         @default(now()) @map("created_at")

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  overrideBy FacultyProfile?      @relation("AttendanceOverrider", fields: [overrideById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, attendanceDate])
  @@index([attendanceDate], name: "idx_attendance_date")
  @@map("attendance_records")
}

model Task {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId   String        @map("assignment_id") @db.Uuid
  templateId     String?       @map("template_id") @db.Uuid
  assignedById   String        @map("assigned_by_id") @db.Uuid
  title          String        @db.VarChar(200)
  description    String?
  requiredSkills String[]      @default([]) @map("required_skills")
  priority       PriorityLevel @default(medium)
  dueDate        DateTime?     @map("due_date") @db.Date
  status         TaskStatus    @default(assigned)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  assignment  InternshipAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  template    InternshipTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedBy  Profile                 @relation("TaskCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  submissions TaskSubmission[]

  @@index([assignmentId], name: "idx_tasks_assignment")
  @@index([status], name: "idx_tasks_status")
  @@map("tasks")
}

model TaskSubmission {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String                 @map("task_id") @db.Uuid
  submittedById  String                 @map("submitted_by_id") @db.Uuid
  submissionText String?                @map("submission_text")
  proofUrl       String                 @map("proof_url")
  submittedAt    DateTime               @default(now()) @map("submitted_at")
  reviewStatus   SubmissionReviewStatus @default(pending) @map("review_status")
  reviewedById   String?                @map("reviewed_by_id") @db.Uuid
  feedback       String?
  reviewedAt     DateTime?              @map("reviewed_at")

  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy StudentProfile @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  Profile?       @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("task_submissions")
}

model Milestone {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String          @map("assignment_id") @db.Uuid
  templateId   String?         @map("template_id") @db.Uuid
  title        String          @db.VarChar(200)
  description  String?
  targetDate   DateTime        @map("target_date") @db.Date
  completedAt  DateTime?       @map("completed_at")
  status       MilestoneStatus @default(pending)
  verifiedById String?         @map("verified_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")

  assignment InternshipAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  template   InternshipMilestoneTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  verifiedBy Profile?                     @relation("MilestoneVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([assignmentId], name: "idx_milestones_assign")
  @@map("milestones")
}

model WorkLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId  String   @map("assignment_id") @db.Uuid
  logDate       DateTime @default(now()) @map("log_date") @db.Date
  hoursWorked   Decimal  @default(8.00) @map("hours_worked") @db.Decimal(4, 2)
  taskTitle     String   @map("task_title") @db.VarChar(200)
  completedWork String   @map("completed_work")
  blockers      String   @default("None")
  nextPlan      String   @default("Continue deliverables") @map("next_plan")
  createdAt     DateTime @default(now()) @map("created_at")

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, logDate], name: "idx_work_logs_date")
  @@map("work_logs")
}

// ── MODULE 5: PERFORMANCE EVALUATION & GOVERNANCE ───────────────────────────

model WeeklyReport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId   String       @map("assignment_id") @db.Uuid
  weekNumber     Int          @map("week_number")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  aiDraftContent String       @map("ai_draft_content")
  finalContent   String?      @map("final_content")
  status         ReportStatus @default(draft)
  submittedAt    DateTime?    @map("submitted_at")
  mentorFeedback String?      @map("mentor_feedback")
  reviewedAt     DateTime?    @map("reviewed_at")
  reviewedById   String?      @map("reviewed_by_id") @db.Uuid

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewedBy Profile?             @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, weekNumber])
  @@map("weekly_reports")
}

model Evaluation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String           @map("assignment_id") @db.Uuid
  evaluatorId       String           @map("evaluator_id") @db.Uuid
  evaluatorRole     AppRole          @map("evaluator_role")
  evaluationType    EvaluationType   @map("evaluation_type")
  evaluationPeriod  String           @map("evaluation_period") @db.VarChar(50)
  technicalSkills   Int              @map("technical_skills")
  qualityOfWork     Int              @map("quality_of_work")
  problemSolving    Int              @map("problem_solving")
  communication     Int
  teamwork          Int
  professionalism   Int
  timeManagement    Int              @map("time_management")
  initiative        Int
  overallRating     Decimal          @map("overall_rating") @db.Decimal(3, 1)
  strengths         String?
  improvementAreas  String?          @map("improvement_areas")
  comments          String?
  status            EvaluationStatus @default(draft)
  crossVerified     Boolean          @default(false) @map("cross_verified")
  crossVerifiedById String?          @map("cross_verified_by_id") @db.Uuid
  crossVerifiedAt   DateTime?        @map("cross_verified_at")
  discrepancyNotes  String?          @map("discrepancy_notes")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")

  assignment      InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  evaluator       Profile              @relation("EvaluationCreator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  crossVerifiedBy FacultyProfile?      @relation("FacultyCrossVerifier", fields: [crossVerifiedById], references: [id], onDelete: SetNull)

  @@index([assignmentId], name: "idx_evals_assign")
  @@map("evaluations")
}

// ── MODULE 6: INTELLIGENCE, RISK & LEARNING ──────────────────────────────────

model HealthScoreSnapshot {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId        String    @map("assignment_id") @db.Uuid
  snapshotDate        DateTime  @default(now()) @map("snapshot_date") @db.Date
  attendanceScore     Decimal   @map("attendance_score") @db.Decimal(5, 2)
  taskCompletionScore Decimal   @map("task_completion_score") @db.Decimal(5, 2)
  milestoneScore      Decimal   @map("milestone_score") @db.Decimal(5, 2)
  workLogScore        Decimal   @map("work_log_score") @db.Decimal(5, 2)
  compositeScore      Decimal   @map("composite_score") @db.Decimal(5, 2)
  riskStatus          RiskLevel @default(on_track) @map("risk_status")

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, snapshotDate])
  @@map("health_score_snapshots")
}

model RiskFlag {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String    @map("assignment_id") @db.Uuid
  riskLevel         RiskLevel @map("risk_level")
  signalReason      String    @map("signal_reason")
  detectedAt        DateTime  @default(now()) @map("detected_at")
  resolved          Boolean   @default(false)
  resolvedAt        DateTime? @map("resolved_at")
  interventionNotes String?   @map("intervention_notes")

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("risk_flags")
}

model LearningResource {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(200)
  category     String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  skillTag     String   @map("skill_tag") @db.VarChar(100)
  url          String
  description  String?
  isFree       Boolean  @default(true) @map("is_free")
  createdAt    DateTime @default(now()) @map("created_at")

  progressLogs StudentLearningProgress[]

  @@index([skillTag], name: "idx_resources_skill")
  @@map("learning_resources")
}

model StudentLearningProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  resourceId      String    @map("resource_id") @db.Uuid
  status          String    @default("recommended") @db.VarChar(30)
  progressPercent Int       @default(0) @map("progress_percent")
  completedAt     DateTime? @map("completed_at")

  student  StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@map("student_learning_progress")
}

model PlacementReadinessSnapshot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  readinessScore  Int      @map("readiness_score")
  skillScore      Int      @map("skill_score")
  internshipScore Int      @map("internship_score")
  evaluationScore Int      @map("evaluation_score")
  recommendations Json
  computedAt      DateTime @default(now()) @map("computed_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("placement_readiness_snapshots")
}

// ── MODULE 7: COMPLETION, PPO & CERTIFICATION ───────────────────────────────

model PPOOffer {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId        String                @unique @map("assignment_id") @db.Uuid
  studentId           String                @map("student_id") @db.Uuid
  companyId           String                @map("company_id") @db.Uuid
  positionTitle       String                @map("position_title") @db.VarChar(150)
  salaryPackage       String                @map("salary_package") @db.VarChar(100)
  joiningDate         DateTime?             @map("joining_date") @db.Date
  location            String?               @db.VarChar(150)
  bondTerms           String?               @map("bond_terms")
  offerLetterUrl      String?               @map("offer_letter_url")
  status              PPOStatus             @default(draft)
  adminApprovalStatus AdminApprovalStatus   @default(pending) @map("admin_approval_status")
  approvedById        String?               @map("approved_by_id") @db.Uuid
  studentResponse     StudentResponseStatus @default(pending) @map("student_response")
  responseDate        DateTime?             @map("response_date")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at")

  assignment InternshipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company    CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedBy Profile?             @relation("PPOAdminApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("ppo_offers")
}

model Certificate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String            @unique @map("assignment_id") @db.Uuid
  studentId         String            @map("student_id") @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  certificateNumber String            @unique @map("certificate_number") @db.VarChar(100)
  qrToken           String            @unique @map("qr_token") @db.VarChar(100)
  certificateUrl    String?           @map("certificate_url")
  issueDate         DateTime          @default(now()) @map("issue_date") @db.Date
  signatoryName     String            @map("signatory_name") @db.VarChar(150)
  signatoryTitle    String            @map("signatory_title") @db.VarChar(150)
  status            CertificateStatus @default(active)
  revocationReason  String?           @map("revocation_reason")
  createdAt         DateTime          @default(now()) @map("created_at")

  assignment       InternshipAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student          StudentProfile               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company          CompanyProfile               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  verificationLogs CertificateVerificationLog[]

  @@index([qrToken], name: "idx_certs_qr")
  @@map("certificates")
}

model CertificateVerificationLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId String   @map("certificate_id") @db.Uuid
  qrToken       String   @map("qr_token") @db.VarChar(100)
  scannedAt     DateTime @default(now()) @map("scanned_at")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("certificate_verification_logs")
}

// ── MODULE 8: COLLABORATION & SYSTEM INFRASTRUCTURE ─────────────────────────

model ChatConversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_conversations")
}

model ChatParticipant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)], name: "idx_chat_msg_time")
  @@map("chat_messages")
}

model Notification {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  category    NotificationCategory
  title       String               @db.VarChar(200)
  message     String
  priority    PriorityLevel        @default(medium)
  actionUrl   String?              @map("action_url") @db.VarChar(255)
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now()) @map("created_at")

  recipient Profile @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read], name: "idx_notif_user")
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  category    String   @default("general") @db.VarChar(50)
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy Profile? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
